{
  "name": "jupyterlab_gruvbox_material",
  "version": "2.0.0",
  "description": "Gruvbox Material (dark) theme for JupyterLab 4.",
  "keywords": [
    "jupyter",
    "jupyterlab",
    "jupyterlab-extension",
    "jupyterlab-theme",
    "gruvbox",
    "gruvbox-material"
  ],
  "homepage": "https://github.com/mergelangelo/jupyterlab-gruvbox-material",
  "bugs": {
    "url": "https://github.com/mergelangelo/jupyterlab-gruvbox-material/issues"
  },
  "license": "BSD-3-Clause",
  "author": {
    "name": "mergelangelo"
  },
  "files": [
    "lib/**/*.{d.ts,js,js.map,json}",
    "style/**/*.css",
    "src/**/*.ts"
  ],
  "main": "lib/index.js",
  "types": "lib/index.d.ts",
  "repository": {
    "type": "git",
    "url": "https://github.com/mergelangelo/jupyterlab-gruvbox-material.git"
  },
  "scripts": {
    "build": "jlpm build:lib && jlpm build:labextension:dev",
    "build:prod": "jlpm clean && jlpm build:lib && jlpm build:labextension",
    "build:labextension": "jupyter labextension build .",
    "build:labextension:dev": "jupyter labextension build --development True .",
    "build:lib": "tsc",
    "clean": "jlpm clean:lib && jlpm clean:labextension",
    "clean:lib": "rimraf lib tsconfig.tsbuildinfo",
    "clean:labextension": "rimraf jupyterlab_gruvbox_material/labextension jupyterlab_gruvbox_material/_version.py",
    "install:extension": "jlpm build",
    "watch": "run-p watch:src watch:labextension",
    "watch:src": "tsc -w",
    "watch:labextension": "jupyter labextension watch ."
  },
  "dependencies": {
    "@jupyterlab/application": "^4.0.0",
    "@jupyterlab/apputils": "^4.0.0"
  },
  "devDependencies": {
    "@jupyterlab/builder": "^4.0.0",
    "npm-run-all2": "^7.0.1",
    "rimraf": "^5.0.10",
    "typescript": "~5.5.4"
  },
  "sideEffects": [
    "style/*.css"
  ],
  "jupyterlab": {
    "extension": true,
    "themePath": "style/theme.css",
    "outputDir": "jupyterlab_gruvbox_material/labextension"
  }
}
